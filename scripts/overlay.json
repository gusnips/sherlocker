{
  "paths": {
    "/regularidade/cpf/{cpf}": {
      "get": {
        "operationId": "getRegularidadeByCpf",
        "summary": "Regularidade de um CPF",
        "description": "Checks de regularidade e compliance, um por módulo: IBAMA, sanções nacionais e internacionais, Banco Central, PEP e outros. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. O formato foi conferido com respostas reais de um CNPJ e de um CPF, e o conjunto de módulos pode variar por documento.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "description": "CPF (11 dígitos)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "description": "Nome da pessoa ou da empresa. Sem ele, os módulos `banco-central`, `sancao-internacional` e `debarment-multilateral` voltam com `status: error`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modulos",
            "in": "query",
            "required": false,
            "description": "Módulos separados por vírgula: ibama, sancao-nacional, banco-central, sancao-internacional, protestos. Sem este parâmetro, todos.",
            "schema": {
              "type": "string",
              "example": "ibama,protestos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Irregularidades achadas em cada módulo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Regularidade"
                }
              }
            }
          }
        }
      }
    },
    "/regularidade/cnpj/{cnpj}": {
      "get": {
        "operationId": "getRegularidadeByCnpj",
        "summary": "Regularidade de um CNPJ",
        "description": "Checks de regularidade e compliance, um por módulo: IBAMA, sanções nacionais e internacionais, trabalho escravo e outros. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. O formato foi conferido com respostas reais de um CNPJ e de um CPF, e o conjunto de módulos pode variar por documento.",
        "parameters": [
          {
            "name": "cnpj",
            "in": "path",
            "required": true,
            "description": "CNPJ (14 dígitos)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "description": "Nome da pessoa ou da empresa. Sem ele, os módulos `banco-central`, `sancao-internacional` e `debarment-multilateral` voltam com `status: error`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modulos",
            "in": "query",
            "required": false,
            "description": "Módulos separados por vírgula: ibama, sancao-nacional, banco-central, sancao-internacional, protestos. Sem este parâmetro, todos.",
            "schema": {
              "type": "string",
              "example": "ibama,protestos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Irregularidades achadas em cada módulo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Regularidade"
                }
              }
            }
          }
        }
      }
    },
    "/perfis": {
      "post": {
        "operationId": "createPerfil",
        "summary": "Executa um perfil",
        "description": "Inicia a execução de um perfil sobre um CPF e devolve o `job_id`. Acompanhe o job em `perfis.getJobStatus`. O `perfil_id` é do seu contrato: a Sherlocker entrega o seu. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. Vem da página \"Perfil: Candidato RH\" da documentação. A mesma `idempotencyKey` em até 24h devolve o mesmo job, sem cobrar de novo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePerfil"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilJobCreated"
                }
              }
            }
          }
        }
      }
    },
    "/pessoas/cpf/{cpf}/empregos": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ListLimit"
          },
          {
            "$ref": "#/components/parameters/ListOffset"
          }
        ]
      }
    },
    "/pessoas/cpf/{cpf}/enderecos": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ListLimit"
          },
          {
            "$ref": "#/components/parameters/ListOffset"
          }
        ]
      }
    },
    "/pessoas/email/{email}": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ListLimit"
          },
          {
            "$ref": "#/components/parameters/ListOffset"
          }
        ]
      }
    },
    "/telefones/cnpj/{cnpj}": {
      "get": {
        "parameters": [
          {
            "name": "whatsapp",
            "in": "query",
            "required": false,
            "description": "Se \"true\", inclui a verificação de WhatsApp.",
            "schema": {
              "type": "string",
              "example": "true"
            }
          }
        ]
      }
    },
    "/processos/cpf/{cpf}": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ProcessosClasses"
          },
          {
            "$ref": "#/components/parameters/ProcessosAssuntos"
          },
          {
            "$ref": "#/components/parameters/ProcessosAreas"
          },
          {
            "$ref": "#/components/parameters/ProcessosPolos"
          },
          {
            "$ref": "#/components/parameters/ProcessosIncludeMovements"
          },
          {
            "$ref": "#/components/parameters/ProcessosForce"
          }
        ]
      }
    },
    "/processos/cnpj/{cnpj}": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/ProcessosClasses"
          },
          {
            "$ref": "#/components/parameters/ProcessosAssuntos"
          },
          {
            "$ref": "#/components/parameters/ProcessosAreas"
          },
          {
            "$ref": "#/components/parameters/ProcessosPolos"
          },
          {
            "$ref": "#/components/parameters/ProcessosIncludeMovements"
          },
          {
            "$ref": "#/components/parameters/ProcessosForce"
          }
        ]
      }
    },
    "/processos/nome": {
      "get": {
        "operationId": "getProcessosByNome",
        "summary": "Processos por nome",
        "description": "Busca direta por nome, sem CPF nem CNPJ. Com `documento`, a Sherlocker descarta as partes que já têm outro documento conhecido. Os arquivos OpenAPI da Sherlocker não trazem este endpoint, só a página \"Vínculo por documento x nome\" da documentação, que também não mostra a resposta. O SDK assume a mesma resposta de processos por CPF. Um nome pode ter homônimos: confirme com o documento antes de decidir algo.",
        "parameters": [
          {
            "name": "nome",
            "in": "query",
            "required": true,
            "description": "Nome da pessoa ou da empresa.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documento",
            "in": "query",
            "required": false,
            "description": "CPF ou CNPJ já conhecido, para tirar homônimos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fonte",
            "in": "query",
            "required": false,
            "description": "Fonte da busca. A documentação só mostra `ambas`.",
            "schema": {
              "type": "string",
              "example": "ambas"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processos achados pelo nome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessosResponse"
                }
              }
            }
          }
        }
      }
    },
    "/processos/jobs/{jobId}/results": {
      "get": {
        "operationId": "getProcessosJobResults",
        "summary": "Resultados de um job de processos",
        "description": "Lista o que o job de tempo real (`realtime=true`) já achou. É o `results_url` que a consulta devolve. Os arquivos OpenAPI da Sherlocker não trazem este endpoint e a documentação não mostra a resposta, então ela vem sem tipo.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados do job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/rural/jobs/{jobId}": {
      "get": {
        "operationId": "getRuralJob",
        "summary": "Status de um job de rural",
        "description": "Status de uma consulta rural assíncrona. A página \"Propriedade Rural\" da documentação lista a rota, mas nenhum arquivo OpenAPI da Sherlocker a descreve e a resposta vem sem tipo.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status do job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ListLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Máximo de registros retornados",
        "schema": {
          "type": "integer",
          "example": 50
        }
      },
      "ListOffset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Número de registros a pular",
        "schema": {
          "type": "integer",
          "example": 0
        }
      },
      "ProcessosClasses": {
        "name": "classes",
        "in": "query",
        "required": false,
        "description": "Filtro por classe processual.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosAssuntos": {
        "name": "assuntos",
        "in": "query",
        "required": false,
        "description": "Filtro por assunto.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosAreas": {
        "name": "areas",
        "in": "query",
        "required": false,
        "description": "Filtro por área.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosPolos": {
        "name": "polos",
        "in": "query",
        "required": false,
        "description": "Filtro por polo.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosIncludeMovements": {
        "name": "include_movements",
        "in": "query",
        "required": false,
        "description": "Se \"false\", não traz as movimentações (padrão: traz).",
        "schema": {
          "type": "string",
          "example": "false"
        }
      },
      "ProcessosForce": {
        "name": "force",
        "in": "query",
        "required": false,
        "description": "Se \"true\" junto com `realtime`, busca de novo mesmo os processos já vinculados (atualiza advogados e movimentações).",
        "schema": {
          "type": "string",
          "example": "true"
        }
      }
    },
    "schemas": {
      "CreatePerfil": {
        "type": "object",
        "required": ["documento", "perfil_id"],
        "properties": {
          "documento": {
            "type": "string",
            "description": "CPF, com ou sem máscara."
          },
          "perfil_id": {
            "type": "string",
            "description": "ID do perfil, do seu contrato."
          },
          "tipos_vinculo": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["documento", "nome"]
            },
            "description": "Tipos de vínculo aceitos nos processos. Padrão: [\"documento\"]. Com \"nome\", entram também processos ligados só pelo nome, e pode haver homônimos."
          }
        }
      },
      "PerfilJobCreated": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "processando"
          },
          "perfil": {
            "type": "object",
            "properties": {
              "perfil_id": {
                "type": "string",
                "nullable": true
              },
              "label": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "criado_em": {
            "type": "string",
            "description": "ISO 8601"
          }
        }
      },
      "Regularidade": {
        "type": "object",
        "description": "Um objeto com uma chave por módulo consultado. Chaves vistas em respostas reais: `ibama`, `ibama-autos`, `sancao-nacional`, `sancao-internacional`, `banco-central` (só CPF), `trabalho-escravo` (só CNPJ), `debarment-multilateral` e `pep` (só CPF). O módulo `protestos` que a tool do MCP cita não veio nas respostas conferidas. Pedir `modulos` devolve só os pedidos que a Sherlocker tem para aquele documento.",
        "additionalProperties": {
          "$ref": "#/components/schemas/RegularidadeModulo"
        }
      },
      "RegularidadeModulo": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean",
            "description": "Se a fonte tem registro do documento."
          },
          "status": {
            "type": "string",
            "description": "Valores vistos: `found`, `not_found` e `error`.",
            "example": "not_found"
          },
          "error": {
            "type": "string",
            "description": "Presente quando `status` é `error`, por exemplo quando a fonte exige o nome e o `nome` não foi enviado."
          },
          "data": {
            "type": "array",
            "description": "Os registros achados. Cada módulo tem os seus campos.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
