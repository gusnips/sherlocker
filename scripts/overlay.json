  "components": {
    "parameters": {
      "ListLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Máximo de registros retornados",
        "schema": {
          "type": "integer",
          "example": 50
        }
      },
      "ListOffset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Número de registros a pular",
        "schema": {
          "type": "integer",
          "example": 0
        }
      },
      "ProcessosClasses": {
        "name": "classes",
        "in": "query",
        "required": false,
        "description": "Filtro por classe processual.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosAssuntos": {
        "name": "assuntos",
        "in": "query",
        "required": false,
        "description": "Filtro por assunto.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosAreas": {
        "name": "areas",
        "in": "query",
        "required": false,
        "description": "Filtro por área.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosPolos": {
        "name": "polos",
        "in": "query",
        "required": false,
        "description": "Filtro por polo.",
        "schema": {
          "type": "string"
        }
      },
      "ProcessosIncludeMovements": {
        "name": "include_movements",
        "in": "query",
        "required": false,
        "description": "Se \"false\", não traz as movimentações (padrão: traz).",
        "schema": {
          "type": "string",
          "example": "false"
        }
      },
      "ProcessosForce": {
        "name": "force",
        "in": "query",
        "required": false,
        "description": "Se \"true\" junto com `realtime`, busca de novo mesmo os processos já vinculados (atualiza advogados e movimentações).",
        "schema": {
          "type": "string",
          "example": "true"
        }
      }
    },
    "schemas": {
      "CreatePerfil": {
        "type": "object",
        "required": ["documento", "perfil_id"],
        "properties": {
          "documento": {
            "type": "string",
            "description": "CPF, com ou sem máscara."
          },
          "perfil_id": {
            "type": "string",
            "description": "ID do perfil, do seu contrato."
          },
          "tipos_vinculo": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["documento", "nome"]
            },
            "description": "Tipos de vínculo aceitos nos processos. Padrão: [\"documento\"]. Com \"nome\", entram também processos ligados só pelo nome, e pode haver homônimos."
          }
        }
      },
      "PerfilJobCreated": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "processando"
          },
          "perfil": {
            "type": "object",
            "properties": {
              "perfil_id": {
                "type": "string",
                "nullable": true
              },
              "label": {
                "type": "string",
