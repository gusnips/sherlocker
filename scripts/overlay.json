{
  "paths": {
    "/regularidade/cpf/{cpf}": {
      "get": {
        "operationId": "getRegularidadeByCpf",
        "summary": "Regularidade de um CPF",
        "description": "Checks de regularidade e compliance, um por módulo: IBAMA, sanções nacionais e internacionais, Banco Central, PEP e outros. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. O formato foi conferido com respostas reais de um CNPJ e de um CPF, e o conjunto de módulos pode variar por documento.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "required": true,
            "description": "CPF (11 dígitos)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "description": "Nome da pessoa. Sem ele, os módulos `banco-central`, `sancao-internacional` e `debarment-multilateral` voltam com `status: error`. Com o nome da pessoa, eles respondem (`found` ou `not_found`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modulos",
            "in": "query",
            "required": false,
            "description": "Módulos separados por vírgula: ibama, sancao-nacional, banco-central, sancao-internacional, protestos. Sem este parâmetro, todos.",
            "schema": {
              "type": "string",
              "example": "ibama,protestos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Irregularidades achadas em cada módulo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Regularidade"
                }
              }
            }
          }
        }
      }
    },
    "/regularidade/cnpj/{cnpj}": {
      "get": {
        "operationId": "getRegularidadeByCnpj",
        "summary": "Regularidade de um CNPJ",
        "description": "Checks de regularidade e compliance, um por módulo: IBAMA, sanções nacionais e internacionais, trabalho escravo e outros. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. O formato foi conferido com respostas reais de um CNPJ e de um CPF, e o conjunto de módulos pode variar por documento.",
        "parameters": [
          {
            "name": "cnpj",
            "in": "path",
            "required": true,
            "description": "CNPJ (14 dígitos)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "description": "Não muda a resposta para um CNPJ. `sancao-internacional` e `debarment-multilateral` voltam com `status: error` (\"Nome é necessário...\") mesmo com `nome`, `name` ou `razao_social`, então esses dois módulos não dão resposta para uma empresa.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modulos",
            "in": "query",
            "required": false,
            "description": "Módulos separados por vírgula: ibama, sancao-nacional, banco-central, sancao-internacional, protestos. Sem este parâmetro, todos.",
            "schema": {
              "type": "string",
              "example": "ibama,protestos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Irregularidades achadas em cada módulo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Regularidade"
                }
              }
            }
          }
        }
      }
    },
    "/perfis": {
      "post": {
        "operationId": "createPerfil",
        "summary": "Executa um perfil",
        "description": "Inicia a execução de um perfil sobre um CPF e devolve o `job_id`. Acompanhe o job em `perfis.getJobStatus`. O `perfil_id` é do seu contrato: a Sherlocker entrega o seu. Os arquivos OpenAPI da Sherlocker não trazem este endpoint. Vem da página \"Perfil: Candidato RH\" da documentação. A mesma `idempotencyKey` em até 24h devolve o mesmo job, sem cobrar de novo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePerfil"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilJobCreated"
                }
              }
            }
          }
        }
      }
    },
